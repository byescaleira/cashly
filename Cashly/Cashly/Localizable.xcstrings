            "state" : "translated",
            "value" : "Es gibt noch wenige Tage und wenig Verlauf; die Prognose wird mit der Zeit besser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún hay pocos días e historial; la previsión mejora con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a encore peu de jours et d’historique ; la prévision s’améliore avec le temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sono ancora pochi giorni e poca cronologia; la previsione migliora col tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ日数も履歴も少ないため、予測は時間とともに精度が上がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 날짜와 기록이 적어 시간이 지날수록 예측이 정확해집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda são poucos dias e pouco histórico; a previsão melhora com o tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока мало дней и истории; со временем прогноз станет точнее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前天数和历史记录较少，预测会随时间更准确。"
          }
        }
      }
    },
