    "There are still few days and little history; the forecast improves over time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt noch wenige Tage und wenig Verlauf; die Prognose wird mit der Zeit besser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún hay pocos días e historial; la previsión mejora con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a encore peu de jours et d’historique ; la prévision s’améliore avec le temps."
          }
        },
        "it" : {
          "stringUnit" : {
