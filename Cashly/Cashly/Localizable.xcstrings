          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте эти столбцы, если есть данные. Пустые ячейки допустимы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
