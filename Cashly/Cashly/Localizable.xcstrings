    "Pick a category and add a short description. Mark it paid or pending, and change the date if it wasn't today." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Kategorie und schreibe eine kurze Beschreibung. Markiere als bezahlt oder offen und ändere das Datum, wenn es nicht heute war."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una categoría y añade una descripción corta. Márcalo como pagado o pendiente y cambia la fecha si no fue hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une catégorie et ajoutez une courte description. Marquez payé ou en attente, et changez la date si ce n'était pas aujourd'hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una categoria e aggiungi una breve descrizione. Segna come pagato o in sospeso e cambia la data se non era oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カテゴリを選び、短い説明を添えます。支払い済みか未払いかを選び、今日でなければ日付を変えましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카테고리를 고르고 짧은 설명을 적으세요. 결제 완료 또는 미결제로 표시하고, 오늘이 아니면 날짜를 바꾸세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma categoria e adicione uma descrição curta. Marque como pago ou pendente e mude a data se não foi hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите категорию и добавьте короткое описание. Отметьте как оплачено или ожидает и измените дату, если это было не сегодня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择分类并添加简短描述。标记为已付或待付，如果不是今天就改一下日期。"
          }
        }
      }
    },
    "Pick a category you spend on every month and set a limit you can keep." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Kategorie, für die du jeden Monat ausgibst, und setze ein Limit, das du halten kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una categoría en la que gastes cada mes y pon un límite que puedas cumplir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une catégorie où vous dépensez chaque mois et fixez une limite tenable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una categoria in cui spendi ogni mese e fissa un limite che puoi rispettare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月使うカテゴリを選び、守れる上限を設定しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매달 쓰는 카테고리를 골라 지킬 수 있는 한도를 정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma categoria em que você gasta todo mês e defina um limite que consiga manter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите категорию, на которую тратите каждый месяц, и задайте посильный лимит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选一个每月都会花钱的分类，设定一个能守住的上限。"
          }
        }
      }
    },
