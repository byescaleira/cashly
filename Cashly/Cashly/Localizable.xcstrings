    "Discreet Mode blurs every amount until you turn it off. Handy on the train or when you show the app to someone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der diskrete Modus verwischt jeden Betrag, bis du ihn ausschaltest. Praktisch in der Bahn oder wenn du jemandem die App zeigst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo discreto difumina todos los importes hasta que lo desactives. Útil en el tren o al enseñarle la app a alguien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode discret floute tous les montants jusqu'à ce que vous le désactiviez. Pratique dans le train ou quand vous montrez l'app à quelqu'un."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità discreta sfoca ogni importo finché non la disattivi. Utile in treno o quando mostri l'app a qualcuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控えめモードはオフにするまですべての金額をぼかします。電車の中や、誰かにアプリを見せるときに便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신중 모드는 끌 때까지 모든 금액을 흐리게 합니다. 지하철에서나 누군가에게 앱을 보여 줄 때 유용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Modo discreto desfoca todos os valores até você desligar. Útil no trem ou quando mostra o app a alguém."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрытный режим размывает все суммы, пока вы его не выключите. Удобно в поезде или когда показываете приложение кому-то."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低调模式会模糊所有金额，直到你关闭它。在地铁上或给别人看应用时很实用。"
          }
        }
      }
    },
