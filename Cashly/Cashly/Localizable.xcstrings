    "Conflicting planned amounts stay out of the totals until you choose which budget to keep." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widersprüchliche geplante Beträge zählen nicht zu den Summen, bis du entscheidest, welches Budget gilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los importes planificados en conflicto quedan fuera de los totales hasta que elijas qué presupuesto conservar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
