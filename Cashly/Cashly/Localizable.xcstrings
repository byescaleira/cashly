            "value" : "Discret"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discreto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控えめ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비공개 모드"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discreto"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скромно"
          }
        },
        "zh-Hans" : {
