    "This version is no longer supported. Update to keep using Cashly. Your data stays on your device and you can export it now." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão não tem mais suporte. Atualize para continuar usando o Cashly. Seus dados continuam no aparelho e você pode exportá-los agora."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión ya no es compatible. Actualiza para seguir usando Cashly. Tus datos siguen en tu dispositivo y puedes exportarlos ahora."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version wird nicht mehr unterstützt. Aktualisiere, um Cashly weiter zu nutzen. Deine Daten bleiben auf deinem Gerät und du kannst sie jetzt exportieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version n’est plus prise en charge. Mettez à jour pour continuer à utiliser Cashly. Vos données restent sur votre appareil et vous pouvez les exporter dès maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione non è più supportata. Aggiorna per continuare a usare Cashly. I tuoi dati restano sul dispositivo e puoi esportarli adesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバージョンはサポートが終了しました。Cashlyを引き続き使うにはアップデートしてください。データはデバイスに残っていて、今すぐ書き出せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전은 더 이상 지원되지 않습니다. Cashly를 계속 사용하려면 업데이트하세요. 데이터는 기기에 그대로 있으며 지금 내보낼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本已不再受支持。请更新以继续使用 Cashly。你的数据仍保存在设备上，现在即可导出。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта версия больше не поддерживается. Обновите приложение, чтобы продолжить пользоваться Cashly. Ваши данные остаются на устройстве, и их можно экспортировать прямо сейчас."
          }
        }
      }
    },
