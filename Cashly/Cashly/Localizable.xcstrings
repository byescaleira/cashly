    "Amounts aren't converted: changing the currency changes the symbol shown and the currency of new records." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beträge werden nicht umgerechnet: Eine andere Währung ändert das angezeigte Symbol und die Währung neuer Einträge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los importes no se convierten: cambiar la moneda cambia el símbolo que se muestra y la moneda de los nuevos registros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les montants ne sont pas convertis : changer de devise modifie le symbole affiché et la devise des nouvelles saisies."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli importi non vengono convertiti: cambiare valuta modifica il simbolo mostrato e la valuta dei nuovi movimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金額は換算されません。通貨を変えると、表示される記号と新しい記録の通貨が変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "금액은 환산되지 않습니다. 통화를 바꾸면 표시되는 기호와 새 기록의 통화가 바뀝니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores não são convertidos: trocar a moeda muda o símbolo exibido e a moeda dos novos registros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Суммы не пересчитываются: смена валюты меняет отображаемый символ и валюту новых записей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金额不会换算：更改货币只会改变显示的符号和新记录的货币。"
          }
        }
      }
    },
