    "Record something today, or tap I Didn't Spend Today in Journey. A freeze covers a missed day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse heute etwas oder tippe in Reise auf „Heute nichts ausgegeben“. Ein Freeze deckt einen verpassten Tag ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra algo hoy o toca Hoy no gasté en Trayectoria. Un congelador cubre un día perdido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez quelque chose aujourd’hui ou touchez Aucune dépense aujourd’hui dans Parcours. Un gel couvre un jour manqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra qualcosa oggi o tocca Oggi non ho speso in Percorso. Un congelamento copre un giorno saltato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日何かを記録するか、ジャーニーで「今日は使っていない」をタップ。フリーズで1日の抜けをカバーできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 무언가를 기록하거나 여정에서 오늘은 지출 없음을 탭하세요. 프리즈가 놓친 하루를 지켜줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre algo hoje ou toque em Hoje não gastei na Jornada. Um congelamento cobre um dia perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите что-нибудь сегодня или нажмите «Сегодня без трат» в разделе Путь. Заморозка покроет пропущенный день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天记录一笔，或在旅程中点按“今天没花钱”。冻结卡可以补上错过的一天。"
          }
        }
      }
    },
    "Pick a challenge in Journey. The first one each month is free." : {
      "localizations" : {
        "de" : {
