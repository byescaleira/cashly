    "Cashly sends this month's summary, encrypted for that browser only. It updates when your data changes and ends in 24 hours." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cashly envia o resumo deste mês, cifrado só para aquele navegador. Ele é atualizado quando seus dados mudam e termina em 24 horas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly envía el resumen de este mes, cifrado solo para ese navegador. Se actualiza cuando cambian tus datos y termina en 24 horas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly sendet die Übersicht dieses Monats, nur für diesen Browser verschlüsselt. Sie wird aktualisiert, wenn sich deine Daten ändern, und endet nach 24 Stunden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly envoie le résumé de ce mois, chiffré pour ce seul navigateur. Il se met à jour quand vos données changent et se termine dans 24 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly invia il riepilogo di questo mese, cifrato solo per quel browser. Si aggiorna quando i tuoi dati cambiano e termina dopo 24 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashlyは今月の概要を、そのブラウザだけが読めるように暗号化して送ります。データが変わると更新され、24時間で終了します。"
          }
        },
        "ko" : {
