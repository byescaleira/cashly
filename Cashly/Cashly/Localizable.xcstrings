          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控えめ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비공개 모드"
          }
        },
        "pt-BR" : {
