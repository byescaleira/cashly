    "Mark \"I didn't spend today\" and the flame keeps going without a transaction." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Heute nichts ausgegeben“ und die Flamme brennt auch ohne Transaktion weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca \"Hoy no gasté\" y la llama sigue sin necesidad de una transacción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez « Je n’ai rien dépensé aujourd’hui » et la flamme continue sans transaction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca \"Oggi non ho speso\" e la fiamma continua senza una transazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今日は使わなかった」を押せば、取引がなくても炎は続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"오늘은 안 썼어요\"를 누르면 거래 없이도 불꽃이 이어져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque \"Hoje não gastei\" e a chama continua sem precisar de transação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте «Сегодня без трат» — огонёк продолжится и без операции."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点「今天没花钱」，没有交易火焰也能延续。"
          }
        }
      }
    },
