    "Cashly keeps this look whatever your device uses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly behält dieses Aussehen, egal was dein Gerät verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly mantiene este aspecto sin importar lo que use tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly garde cette apparence, quel que soit le réglage de ton appareil."
