    "The profile and all of its data are deleted from iCloud, for you and everyone you invited." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil und alle seine Daten werden aus iCloud gelöscht, für dich und alle Eingeladenen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
