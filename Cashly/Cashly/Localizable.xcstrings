    "Budgets and categories. Set how much you want to spend and follow the month's pace." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budgets und Kategorien. Lege fest, wie viel du ausgeben willst, und behalte das Tempo des Monats im Blick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presupuestos y categorías. Define cuánto quieres gastar y sigue el ritmo del mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budgets et catégories. Définissez combien vous voulez dépenser et suivez le rythme du mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budget e categorie. Decidi quanto vuoi spendere e segui il ritmo del mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算とカテゴリ。使う金額を決めて、月のペースを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예산과 카테고리. 지출할 금액을 정하고 이번 달의 흐름을 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orçamentos e categorias. Defina quanto quer gastar e acompanhe o ritmo do mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бюджеты и категории. Решите, сколько хотите тратить, и следите за темпом месяца."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预算和类别。设置想花多少钱，并跟进本月节奏。"
          }
        }
      }
    },
