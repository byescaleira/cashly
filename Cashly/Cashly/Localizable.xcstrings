    "Records saved in %@ appear converted at the current rate, as an estimate. The original amounts stay saved as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge in %@ erscheinen zum aktuellen Kurs umgerechnet, als Schätzung. Die ursprünglichen Beträge bleiben unverändert gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros guardados en %@ aparecen convertidos al tipo de cambio actual, como estimación. Los importes originales se mantienen tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements en %@ apparaissent convertis au taux actuel, à titre d'estimation. Les montants d'origine restent enregistrés tels quels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I record salvati in %@ appaiono convertiti al tasso attuale, come stima. Gli importi originali restano salvati così come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
