    "%@ already has a budget in %@. Pick another month or edit that budget." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat für %2$@ schon ein Budget. Wähle einen anderen Monat oder bearbeite dieses Budget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya tiene un presupuesto en %2$@. Elige otro mes o edita ese presupuesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a déjà un budget pour %2$@. Choisissez un autre mois ou modifiez ce budget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha già un budget per %2$@. Scegli un altro mese o modifica quel budget."
