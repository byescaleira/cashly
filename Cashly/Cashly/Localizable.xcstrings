        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe deine aktuelle Challenge vor ihrem Ende ab, damit sie zählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa tu reto actual antes de que termine para que cuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réussissez votre défi en cours avant sa fin pour qu’il compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa la sfida in corso prima che finisca perché conti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今のチャレンジを期限内に達成するとカウントされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 중인 챌린지를 기한 안에 완료하면 집계돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conclua o desafio atual antes do fim para ele contar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните текущий челлендж до его окончания, чтобы он засчитался."
