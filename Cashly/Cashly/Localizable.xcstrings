    "On iPad and Mac, Home and categories make use of the screen width." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf iPad und Mac nutzen die Übersicht und die Kategorien die volle Bildschirmbreite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iPad y Mac, Inicio y las categorías aprovechan el ancho de la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur iPad et Mac, Accueil et les catégories exploitent toute la largeur de l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su iPad e Mac, la Home e le categorie sfruttano la larghezza dello schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadとMacでは、ホームとカテゴリが画面の幅を活用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad와 Mac에서는 홈과 카테고리가 화면 너비를 활용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iPad e no Mac, o Início e as categorias aproveitam a largura da tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На iPad и Mac главная и категории используют всю ширину экрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPad 和 Mac 上，首页和类别会充分利用屏幕宽度。"
          }
        }
      }
    },
