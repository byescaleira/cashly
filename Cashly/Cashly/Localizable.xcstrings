        }
      }
    },
    "iCloud Drive isn't available. Check that you're signed in to iCloud and that iCloud Drive is turned on. Meanwhile, backups stay on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive ist nicht verfügbar. Prüfe, ob du bei iCloud angemeldet bist und iCloud Drive aktiviert ist. Bis dahin bleiben Backups auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive no está disponible. Comprueba que iniciaste sesión en iCloud y que iCloud Drive está activado. Mientras tanto, las copias se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive n’est pas disponible. Vérifiez que vous êtes connecté à iCloud et qu’iCloud Drive est activé. En attendant, les sauvegardes restent sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive non è disponibile. Verifica di aver eseguito l’accesso a iCloud e che iCloud Drive sia attivo. Nel frattempo, i backup restano su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Driveを利用できません。iCloudにサインインしていて、iCloud Driveがオンになっているか確認してください。それまでバックアップはこのデバイスに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive를 사용할 수 없습니다. iCloud에 로그인되어 있고 iCloud Drive가 켜져 있는지 확인하세요. 그동안 백업은 이 기기에 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud Drive não está disponível. Confira se você entrou no iCloud e se o iCloud Drive está ligado. Enquanto isso, os backups ficam neste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive недоступен. Проверьте, что вы вошли в iCloud и что iCloud Drive включён. Пока что копии хранятся на этом устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 云盘不可用。请确认你已登录 iCloud 并已开启 iCloud 云盘。在此期间，备份会保存在此设备上。"
          }
        }
      }
    },
    "iCloud Drive isn't available. Sign in to iCloud and turn on iCloud Drive to keep backups there." : {
      "localizations" : {
        "de" : {
