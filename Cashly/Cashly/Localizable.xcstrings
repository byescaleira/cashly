          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт остаётся бесплатным. С Cashly Pro приложение само делает резервные копии и переносит историю из других файлов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
