    "\"Add income in Cashly\", \"How much is left in Groceries in Cashly\", \"Mark a bill as paid in Cashly\" and \"Capture a payment in Cashly\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Einnahme in Cashly erfassen“, „Wie viel bleibt in Lebensmittel in Cashly“, „Markiere eine Rechnung in Cashly als bezahlt“ und „Erfasse eine Zahlung in Cashly“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Añadir un ingreso en Cashly», «Cuánto queda en Mercado en Cashly», «Marca una cuenta como pagada en Cashly» y «Captura un pago en Cashly»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Ajouter un revenu dans Cashly », « Combien reste-t-il dans Courses dans Cashly », « Marque une facture comme payée dans Cashly » et « Capture un paiement dans Cashly »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Aggiungi un’entrata in Cashly\", \"Quanto resta in Spesa in Cashly\", \"Segna una bolletta come pagata in Cashly\" e \"Cattura un pagamento in Cashly\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Cashlyで収入を追加」「Cashlyの食料品の残りはいくら」「Cashlyで請求を支払い済みにして」「Cashlyで支払いを取り込んで」。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Cashly에 수입 추가\", \"Cashly에서 식료품 얼마 남았어\", \"Cashly에서 청구서를 결제 완료로 표시해 줘\", \"Cashly에서 결제 캡처해 줘\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Registrar uma entrada no Cashly\", \"Quanto sobrou em Mercado no Cashly\", \"Marcar uma conta como paga no Cashly\" e \"Capturar um pagamento no Cashly\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Добавить доход в Cashly», «Сколько осталось в Продуктах в Cashly», «Отметь счёт оплаченным в Cashly» и «Захвати платёж в Cashly»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“在 Cashly 中添加收入”、“Cashly 中杂货还剩多少”、“在 Cashly 中把账单标记为已付”和“在 Cashly 中捕获一笔付款”。"
          }
        }
      }
    },
