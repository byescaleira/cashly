          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fila por transacción. %1$@, %2$@ e %3$@ son obligatorias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne par transaction. %1$@, %2$@ et %3$@ sont obligatoires."
          }
        },
        "it" : {
          "stringUnit" : {
