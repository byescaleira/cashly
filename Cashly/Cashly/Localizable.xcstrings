        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia del %@. No se borra nada: los registros que ya están aquí se actualizan con la versión del archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde du %@. Rien n'est supprimé : les éléments déjà présents sont mis à jour avec la version du fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup del %@. Non si cancella nulla: i record già presenti vengono aggiornati con la versione del file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のバックアップです。削除されるものはなく、すでにある記録はファイルの内容で更新されます。"
