        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive를 사용할 수 없습니다. 백업을 보관하려면 iCloud에 로그인하고 iCloud Drive를 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
