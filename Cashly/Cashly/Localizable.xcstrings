        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ultrapassou o orçamento planejado. Ajuste os gastos e priorize o essencial para retomar o controle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы превысили запланированный бюджет. Скорректируйте расходы и сосредоточьтесь на главном, чтобы вернуть контроль."
