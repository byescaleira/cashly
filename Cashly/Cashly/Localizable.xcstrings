    "Cashly projects where the month will land from your pace so far and the bills you have already recorded. It updates every time you record." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly rechnet aus deinem bisherigen Tempo und den bereits erfassten Rechnungen hoch, wo der Monat landet. Mit jeder Erfassung aktualisiert es sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly proyecta dónde acabará el mes a partir de tu ritmo y de las cuentas ya registradas. Se actualiza cada vez que registras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly projette où le mois va atterrir à partir de votre rythme et des factures déjà enregistrées. Ça se met à jour à chaque enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly proietta dove finirà il mese dal tuo ritmo finora e dalle bollette già registrate. Si aggiorna ogni volta che registri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これまでのペースと記録済みの請求から、月末の着地を予測します。記録するたびに更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금까지의 속도와 이미 기록한 청구서로 이번 달의 결과를 예측합니다. 기록할 때마다 갱신됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cashly projeta onde o mês vai terminar a partir do seu ritmo até aqui e das contas já registradas. Atualiza a cada registro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly прогнозирует итог месяца по вашему темпу и уже записанным счетам. Прогноз обновляется при каждой записи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly 根据目前的节奏和已记录的账单预测本月结果。每次记录都会更新。"
          }
        }
      }
    },
