          "stringUnit" : {
            "state" : "translated",
            "value" : "La commande Nouvelle dépense ouvre Cashly sur une nouvelle dépense depuis le centre de contrôle, l’écran verrouillé ou le bouton Action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il controllo Nuova spesa apre Cashly su una nuova spesa dal Centro di Controllo, dalla schermata di blocco o dal tasto Azione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「新しい支出」コントロールで、コントロールセンター、ロック画面、アクションボタンから新しい支出を開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 지출 제어로 제어 센터, 잠금 화면, 동작 버튼에서 새 지출을 열 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O controle Novo gasto abre o Cashly num gasto novo pela Central de Controle, pela Tela Bloqueada ou pelo Botão de Ação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элемент «Новый расход» открывает Cashly с новым расходом из Пункта управления, экрана блокировки или кнопки действия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
