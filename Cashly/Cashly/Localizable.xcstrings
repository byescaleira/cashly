    },
    "%@ arrives in five seconds. Lock the device to see it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kommt in fünf Sekunden. Sperre das Gerät, um sie zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ llega en cinco segundos. Bloquea el dispositivo para verla."
