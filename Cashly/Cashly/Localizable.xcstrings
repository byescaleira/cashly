    "Cashly never sees your face, fingerprint or passcode, only whether unlocking worked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly sieht nie dein Gesicht, deinen Fingerabdruck oder deinen Code, nur ob das Entsperren geklappt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly nunca ve tu cara, tu huella ni tu código, solo si el desbloqueo funcionó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly ne voit jamais votre visage, votre empreinte ni votre code, seulement si le déverrouillage a réussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly non vede mai il tuo volto, l’impronta o il codice, solo se lo sblocco è riuscito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashlyが顔、指紋、パスコードを見ることはなく、ロック解除できたかどうかだけを受け取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly는 얼굴, 지문, 암호를 보지 않고 잠금 해제 성공 여부만 알아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cashly nunca vê seu rosto, sua digital ou seu código, só se o desbloqueio deu certo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly не видит ваше лицо, отпечаток или код — только то, удалось ли разблокировать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly 永远看不到你的面容、指纹或密码，只知道解锁是否成功。"
          }
        }
      }
    },
    "Discreet" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskret"
          }
        },
        "es" : {
