          }
        }
      }
    },
    "Without Cashly Pro your data stays visible and exportable, but recording and editing are locked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Cashly Pro bleiben deine Daten sichtbar und exportierbar, aber Erfassen und Bearbeiten sind gesperrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin Cashly Pro tus datos siguen visibles y exportables, pero registrar y editar quedan bloqueados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans Cashly Pro, vos données restent visibles et exportables, mais l’enregistrement et la modification sont verrouillés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza Cashly Pro i tuoi dati restano visibili ed esportabili, ma registrare e modificare sono bloccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly Proがなくてもデータの閲覧と書き出しはできますが、記録と編集はロックされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly Pro가 없어도 데이터를 보고 내보낼 수 있지만, 기록과 편집은 잠겨요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem o Cashly Pro seus dados continuam visíveis e exportáveis, mas registrar e editar ficam bloqueados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без Cashly Pro данные остаются доступными для просмотра и экспорта, но запись и редактирование заблокированы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有 Cashly Pro，数据仍可查看和导出，但记录和编辑会被锁定。"
          }
        }
      }
    },
    "Without a plan there's nothing to compare against." : {
