    "Tap a backup to review its records before importing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf ein Backup, um die Einträge vor dem Import zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una copia para revisar sus registros antes de importarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une sauvegarde pour vérifier son contenu avant de l’importer."
