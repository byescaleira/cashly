    "Only the browser whose QR code you scan can open it. Our bridge can't read it." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o navegador cujo QR code você leu consegue abrir. Nossa ponte não consegue ler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo el navegador cuyo código QR escaneas puede abrirlo. Nuestro puente no puede leerlo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Browser, dessen QR-Code du scannst, kann sie öffnen. Unsere Brücke kann sie nicht lesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le navigateur dont vous scannez le code QR peut l’ouvrir. Notre passerelle ne peut pas le lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo il browser di cui scansioni il codice QR può aprirlo. Il nostro ponte non può leggerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開けるのは、QRコードを読み取ったブラウザだけ。中継サーバは内容を読めません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR 코드를 스캔한 브라우저만 열 수 있습니다. 중계 서버는 읽을 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有你扫描过二维码的那个浏览器能打开。我们的中转服务器无法读取。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть её может только браузер, чей QR-код вы отсканировали. Наш мост не может её прочитать."
          }
        }
      }
    },
    "Each connection lasts 24 hours, and you can disconnect it anytime." : {
      "localizations" : {
        "pt-BR" : {
