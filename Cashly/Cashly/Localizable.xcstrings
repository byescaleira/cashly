    "Up to the amount you usually spend per purchase. Each one is small, but together they add up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu dem Betrag, den du pro Einkauf meist ausgibst. Einzeln klein, zusammen spürbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta el importe que sueles gastar por compra. Cada una es pequeña, pero juntas suman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’au montant que vous dépensez habituellement par achat. Chacun est petit, mais ensemble ils pèsent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino all’importo che spendi di solito per acquisto. Ognuna è piccola, ma insieme si sommano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回の買い物でふだん使う金額以下のものです。1つずつは小さくても、合わせると大きくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 구매에 평소 쓰는 금액 이하입니다. 하나하나는 작아도 모이면 커집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até o valor que você costuma gastar por compra. Cada uma é pequena, mas juntas somam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До суммы, которую вы обычно тратите за покупку. По отдельности мелочь, но вместе набегает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不超过你平时每次消费的金额。单笔不大，加起来就多了。"
          }
        }
      }
    },
