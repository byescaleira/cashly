    "Export and import your data, create a spreadsheet of your transactions and turn on the weekly automatic backup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiere und importiere deine Daten, erstelle eine Tabelle deiner Transaktionen und aktiviere das wöchentliche automatische Backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta e importa tus datos, crea una hoja de cálculo con tus transacciones y activa la copia de seguridad automática semanal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez et importez vos données, créez un tableur de vos transactions et activez la sauvegarde automatique hebdomadaire."
          }
        },
        "it" : {
          "stringUnit" : {
