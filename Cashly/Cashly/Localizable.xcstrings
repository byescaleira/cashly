    "This can't be undone. Cashly keeps nothing on a server to bring it back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das lässt sich nicht rückgängig machen. Cashly speichert nichts auf einem Server, um es wiederherzustellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede deshacer. Cashly no guarda nada en un servidor para recuperarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'annuler. Cashly ne garde rien sur un serveur pour le récupérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si può annullare. Cashly non conserva nulla su un server per recuperarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元に戻せません。Cashlyは復元用のデータをサーバに保存していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "되돌릴 수 없습니다. Cashly는 복구용 데이터를 서버에 보관하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não dá para desfazer. O Cashly não guarda nada em servidor para recuperar depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
