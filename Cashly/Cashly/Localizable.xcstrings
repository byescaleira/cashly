    "Mark it from the notification, from the transaction, or say \"Mark a bill as paid in Cashly\" to Siri." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere sie in der Mitteilung, in der Transaktion oder sag Siri „Markiere eine Rechnung in Cashly als bezahlt“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Márcala desde la notificación, desde la transacción o dile a Siri «Marca una cuenta como pagada en Cashly»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez-la depuis la notification, depuis la transaction, ou dites à Siri « Marque une facture comme payée dans Cashly »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnala dalla notifica, dalla transazione o di' a Siri \"Segna una bolletta come pagata in Cashly\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知から、取引から、または Siri に「Cashlyで請求を支払い済みにして」と話しかけて。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림에서, 거래에서, 또는 Siri에게 \"Cashly에서 청구서를 결제 완료로 표시해 줘\"라고 말하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque pela notificação, pela transação ou diga à Siri \"Marcar uma conta como paga no Cashly\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте из уведомления, из транзакции или скажите Siri: «Отметь счёт оплаченным в Cashly»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在通知里、在交易里标记，或对 Siri 说“在 Cashly 中把账单标记为已付”。"
          }
        }
      }
    },
