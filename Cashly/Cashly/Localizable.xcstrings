    "Disconnecting deletes the summary from the bridge right away, and that browser goes back to the QR code." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconectar apaga o resumo da ponte na hora, e aquele navegador volta ao QR code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desconectar, el resumen se borra del puente al instante y ese navegador vuelve al código QR."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Trennen wird die Übersicht sofort von der Brücke gelöscht, und der Browser zeigt wieder den QR-Code."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
