    "Choose a Cashly backup file (.json). The file's records are added to the ones already on this device; nothing is deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Cashly-Backupdatei (.json). Die Einträge der Datei werden zu denen auf diesem Gerät hinzugefügt; nichts wird gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un archivo de copia de seguridad de Cashly (.json). Los registros del archivo se suman a los que ya están en el dispositivo; no se elimina nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un fichier de sauvegarde Cashly (.json). Ses données s’ajoutent à celles de l’appareil ; rien n’est supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un file di backup di Cashly (.json). I dati del file si aggiungono a quelli già presenti sul dispositivo; non viene eliminato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashlyのバックアップファイル（.json）を選択してください。ファイルの記録はこのデバイスの記録に追加され、何も削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly 백업 파일(.json)을 선택하세요. 파일의 기록은 이 기기의 기록에 추가되며 아무것도 삭제되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um arquivo de backup do Cashly (.json). Os registros do arquivo são somados aos que já estão no aparelho; nada é apagado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите файл резервной копии Cashly (.json). Записи из файла добавятся к имеющимся на устройстве; ничего не удаляется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 Cashly 备份文件（.json）。文件中的记录会添加到此设备已有的记录中，不会删除任何内容。"
          }
        }
      }
    },
