    "Appearance, currency, notifications, backup, features and MCP server go back to their defaults. Your data isn't deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darstellung, Währung, Mitteilungen, Backup, Funktionen und MCP-Server werden zurückgesetzt. Deine Daten werden nicht gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La apariencia, la moneda, las notificaciones, la copia de seguridad, las funciones y el servidor MCP vuelven a sus valores predeterminados. Tus datos no se eliminan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’apparence, la devise, les notifications, la sauvegarde, les fonctionnalités et le serveur MCP reviennent à leurs valeurs par défaut. Vos données ne sont pas supprimées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetto, valuta, notifiche, backup, funzioni e server MCP tornano ai valori predefiniti. I tuoi dati non vengono eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外観、通貨、通知、バックアップ、機能、MCPサーバが初期設定に戻ります。データは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 모드, 통화, 알림, 백업, 기능, MCP 서버가 기본값으로 돌아갑니다. 데이터는 삭제되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparência, moeda, notificações, backup, recursos e servidor MCP voltam ao padrão. Os dados não são apagados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оформление, валюта, уведомления, резервное копирование, функции и сервер MCP вернутся к значениям по умолчанию. Данные не удаляются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外观、货币、通知、备份、功能和 MCP 服务器将恢复默认设置。你的数据不会被删除。"
          }
        }
      }
    },
