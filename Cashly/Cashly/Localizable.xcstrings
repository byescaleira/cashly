    "%@ of the month's spending. In a typical month, that adds up to %@ a year." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ der Ausgaben des Monats. In einem normalen Monat sind das %2$@ im Jahr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ del gasto del mes. En un mes normal, eso suma %2$@ al año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ des dépenses du mois. Sur un mois habituel, cela fait %2$@ par an."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ della spesa del mese. In un mese normale fanno %2$@ all’anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今月の支出の%1$@。ふだんの月なら、年間%2$@になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 달 지출의 %1$@입니다. 평소 같은 달이면 1년에 %2$@가 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dos gastos do mês. Num mês comum, isso dá %2$@ por ano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ расходов месяца. В обычный месяц это %2$@ в год."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "占本月支出的 %1$@。按平常的月份算，一年是 %2$@。"
          }
        }
      }
    },
