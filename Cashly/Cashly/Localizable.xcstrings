    "Spending went over budget. Cut non-essential expenses and keep a close eye on your cash so it doesn't get worse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausgaben haben das Budget überschritten. Streiche nicht notwendige Ausgaben und behalte dein Geld genau im Blick, damit es nicht schlimmer wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gasto superó el presupuesto. Recorta gastos no esenciales y vigila tu dinero de cerca para que no empeore."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépenses ont dépassé le budget. Réduisez les dépenses non essentielles et surveillez votre trésorerie de près pour éviter que ça empire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La spesa ha superato il budget. Taglia le spese non essenziali e tieni d’occhio la liquidità per non peggiorare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出が予算を超えました。不要な支出を減らし、お金の流れをよく確認して悪化を防ぎましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지출이 예산을 넘었습니다. 필수적이지 않은 지출을 줄이고 자금 흐름을 꼼꼼히 확인해 더 나빠지지 않게 하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os gastos passaram do orçamento. Corte despesas não essenciais e acompanhe o caixa de perto para não piorar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расходы вышли за бюджет. Сократите необязательные траты и внимательно следите за деньгами, чтобы не стало хуже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出已超出预算。削减非必要开支，密切关注现金流，避免情况恶化。"
          }
        }
      }
    },
