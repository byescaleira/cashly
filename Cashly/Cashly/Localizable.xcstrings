    "With Cashly Pro, Claude Code connects to Cashly on this device to answer questions, run analyses and import statements." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Cashly Pro verbindet sich Claude Code auf diesem Gerät mit Cashly, beantwortet Fragen, erstellt Analysen und importiert Kontoauszüge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Cashly Pro, Claude Code se conecta a Cashly en este dispositivo para responder preguntas, hacer análisis e importar extractos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Cashly Pro, Claude Code se connecte à Cashly sur cet appareil pour répondre à vos questions, faire des analyses et importer des relevés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Cashly Pro, Claude Code si collega a Cashly su questo dispositivo per rispondere a domande, fare analisi e importare estratti conto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly Pro なら、Claude Code がこのデバイスの Cashly につながり、質問への回答、分析、明細の取り込みを行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly Pro를 쓰면 Claude Code가 이 기기의 Cashly에 연결되어 질문에 답하고, 분석하고, 명세서를 가져옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o Cashly Pro, o Claude Code se conecta ao Cashly neste aparelho para responder perguntas, fazer análises e importar extratos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С Cashly Pro Claude Code подключается к Cashly на этом устройстве, отвечает на вопросы, проводит анализ и импортирует выписки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
