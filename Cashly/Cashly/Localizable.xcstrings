    "Everything lives on your device and in your iCloud. No account, no servers, no third parties. Export a backup anytime." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles liegt auf deinem Gerät und in deiner iCloud. Kein Konto, keine Server, keine Dritten. Exportiere jederzeit ein Backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo vive en tu dispositivo y en tu iCloud. Sin cuenta, sin servidores, sin terceros. Exporta una copia cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste sur votre appareil et dans votre iCloud. Pas de compte, pas de serveurs, pas de tiers. Exportez une sauvegarde quand vous voulez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto vive sul tuo dispositivo e nel tuo iCloud. Nessun account, nessun server, nessuna terza parte. Esporta un backup quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてはあなたのデバイスとiCloudの中に。アカウントもサーバーも第三者もなし。バックアップはいつでも書き出せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 것은 내 기기와 내 iCloud에 있습니다. 계정도, 서버도, 제3자도 없습니다. 언제든 백업을 내보내세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo fica no seu aparelho e no seu iCloud. Sem conta, sem servidores, sem terceiros. Exporte um backup quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё хранится на вашем устройстве и в вашем iCloud. Без учётной записи, серверов и третьих сторон. Экспортируйте резервную копию в любой момент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都在你的设备和 iCloud 中。没有账户、没有服务器、没有第三方。随时可以导出备份。"
          }
        }
      }
    },
