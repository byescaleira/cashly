    "iCloud Drive isn't available. Check that you're signed in to iCloud and that iCloud Drive is turned on. Meanwhile, backups stay on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive ist nicht verfügbar. Prüfe, ob du bei iCloud angemeldet bist und iCloud Drive aktiviert ist. Bis dahin bleiben Backups auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive no está disponible. Comprueba que iniciaste sesión en iCloud y que iCloud Drive está activado. Mientras tanto, las copias se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive n’est pas disponible. Vérifiez que vous êtes connecté à iCloud et qu’iCloud Drive est activé. En attendant, les sauvegardes restent sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive non è disponibile. Verifica di aver eseguito l’accesso a iCloud e che iCloud Drive sia attivo. Nel frattempo, i backup restano su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Driveを利用できません。iCloudにサインインしていて、iCloud Driveがオンになっているか確認してください。それまでバックアップはこのデバイスに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive를 사용할 수 없습니다. iCloud에 로그인되어 있고 iCloud Drive가 켜져 있는지 확인하세요. 그동안 백업은 이 기기에 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud Drive não está disponível. Confira se você entrou no iCloud e se o iCloud Drive está ligado. Enquanto isso, os backups ficam neste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive недоступен. Проверьте, что вы вошли в iCloud и что iCloud Drive включён. Пока что копии хранятся на этом устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 云盘不可用。请确认你已登录 iCloud 并已开启 iCloud 云盘。在此期间，备份会保存在此设备上。"
          }
        }
      }
    },
    "iCloud Drive isn't available. Sign in to iCloud and turn on iCloud Drive to keep backups there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive ist nicht verfügbar. Melde dich bei iCloud an und aktiviere iCloud Drive, um Backups dort zu sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive no está disponible. Inicia sesión en iCloud y activa iCloud Drive para guardar ahí las copias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive n’est pas disponible. Connectez-vous à iCloud et activez iCloud Drive pour y conserver les sauvegardes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive non è disponibile. Accedi a iCloud e attiva iCloud Drive per salvare lì i backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Driveを利用できません。バックアップを保存するには、iCloudにサインインしてiCloud Driveをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive를 사용할 수 없습니다. 백업을 보관하려면 iCloud에 로그인하고 iCloud Drive를 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud Drive não está disponível. Entre no iCloud e ligue o iCloud Drive para guardar os backups nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive недоступен. Войдите в iCloud и включите iCloud Drive, чтобы хранить там копии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 云盘不可用。请登录 iCloud 并开启 iCloud 云盘，以将备份保存在其中。"
          }
        }
      }
    },
    "iOS lets only you create automations, so this part takes a minute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur du kannst in iOS Automationen erstellen, deshalb dauert dieser Teil eine Minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tú puedes crear automatizaciones en iOS, así que esta parte lleva un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul vous pouvez créer des automatisations dans iOS : cette étape prend une minute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tu puoi creare automazioni in iOS, quindi questa parte richiede un minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オートメーションを作れるのはあなただけなので、ここは1分ほどかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS에서는 직접 자동화를 만들어야 해서 1분 정도 걸려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só você pode criar automações no iOS, então esta parte leva um minuto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В iOS автоматизации создаёте только вы, это займёт минуту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有你能在 iOS 中创建自动化，这一步大约需要一分钟。"
          }
        }
      }
