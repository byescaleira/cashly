          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вспомните ответ на главный вопрос жизни, вселенной и всего такого."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
