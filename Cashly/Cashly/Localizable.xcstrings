          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда делите расход, добавьте людей в редакторе. Каждый разделённый расход считается один раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分摊支出时，在编辑器中添加参与者。每笔分摊支出计一次。"
