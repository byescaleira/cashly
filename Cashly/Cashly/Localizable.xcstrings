          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros, sequências, missões e desafios rendem XP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XP дают записи, серии, миссии и челленджи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记账、连续记录、任务和挑战都能获得 XP。"
          }
        }
      }
    },
    "Records an expense with everything the editor has: category, description, status, date, tags, participants, split and installments." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
