    "Send the invitation by Messages, Mail or AirDrop. When they accept, this profile shows up in their Cashly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende die Einladung per Nachrichten, Mail oder AirDrop. Sobald sie angenommen wird, erscheint das Profil in ihrem Cashly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía la invitación por Mensajes, Mail o AirDrop. Cuando la acepten, este perfil aparecerá en su Cashly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez l’invitation par Messages, Mail ou AirDrop. Une fois acceptée, ce profil apparaît dans leur Cashly."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia l’invito con Messaggi, Mail o AirDrop. Quando lo accettano, questo profilo compare nel loro Cashly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージ、メール、AirDropで招待を送りましょう。相手が受け入れると、このプロファイルが相手のCashlyに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지, Mail 또는 AirDrop으로 초대를 보내세요. 상대가 수락하면 이 프로필이 상대의 Cashly에 나타납니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mande o convite por Mensagens, Mail ou AirDrop. Quando a pessoa aceitar, este perfil aparece no Cashly dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправьте приглашение через «Сообщения», Почту или AirDrop. Когда его примут, профиль появится в их Cashly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过“信息”、“邮件”或隔空投送发送邀请。对方接受后，此档案会出现在他们的 Cashly 中。"
          }
        }
      }
    },
    "Sets a fixed amount for each profile." : {
