    "They live on this device and, with iCloud sync on, in your own iCloud account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie liegen auf diesem Gerät und bei aktiver iCloud-Synchronisierung in deinem eigenen iCloud-Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardan en este dispositivo y, con la sincronización de iCloud activada, en tu propia cuenta de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils sont stockés sur cet appareil et, si la synchronisation iCloud est activée, dans votre propre compte iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restano su questo dispositivo e, con la sincronizzazione iCloud attiva, nel tuo account iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録はこのデバイスに保存され、iCloud同期がオンならあなた自身のiCloudアカウントにも保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록은 이 기기에 저장되고, iCloud 동기화를 켜면 내 iCloud 계정에도 저장돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles ficam neste aparelho e, com a sincronização do iCloud ligada, na sua própria conta do iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи хранятся на этом устройстве, а при включённой синхронизации — в вашей учётной записи iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录保存在此设备上；开启 iCloud 同步时，也保存在你自己的 iCloud 账户中。"
          }
        }
      }
    },
    "Unlocking stays with the system" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
