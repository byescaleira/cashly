            "state" : "translated",
            "value" : "Funktioniert überall, auch in anderen Apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona en cualquier pantalla, incluso dentro de otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne sur tous les écrans, même dans d’autres apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona in qualsiasi schermata, anche dentro altre app."
          }
        },
        "ja" : {
