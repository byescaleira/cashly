    "Exporting stays free. With Cashly Pro, Cashly keeps backups for you and brings in your history from other files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportieren bleibt kostenlos. Mit Cashly Pro erstellt Cashly Backups für dich und übernimmt deinen Verlauf aus anderen Dateien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportar sigue siendo gratis. Con Cashly Pro, Cashly hace copias de seguridad por ti y trae tu historial desde otros archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'export reste gratuit. Avec Cashly Pro, Cashly sauvegarde pour vous et importe votre historique depuis d'autres fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esportare resta gratis. Con Cashly Pro, Cashly fa i backup per te e importa la tua cronologia da altri file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き出しはずっと無料。Cashly Pro なら、バックアップを自動で作り、ほかのファイルから履歴を取り込めます。"
