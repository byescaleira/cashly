    "Icons, colors, streak helps and challenge packs. Items are yours for good. Every guide you finish is worth 20 XP." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icons, Farben, Serien-Hilfen und Herausforderungspakete. Was du kaufst, gehört dir für immer. Jede abgeschlossene Anleitung bringt 20 XP."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iconos, colores, ayudas de racha y packs de desafíos. Los artículos son tuyos para siempre. Cada guía terminada vale 20 XP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icônes, couleurs, aides de série et packs de défis. Les articles sont à vous pour de bon. Chaque guide terminé vaut 20 XP."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icone, colori, aiuti per la serie e pacchetti di sfide. Gli articoli sono tuoi per sempre. Ogni guida completata vale 20 XP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイコン、カラー、ストリークの助け、チャレンジパック。買ったものはずっとあなたのもの。ガイドを1つ終えるごとに20XP。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이콘, 색상, 스트릭 도움, 챌린지 팩. 아이템은 영원히 내 것. 가이드를 하나 마칠 때마다 20 XP."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ícones, cores, ajudas de sequência e pacotes de desafios. Os itens são seus para sempre. Cada guia concluído vale 20 XP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значки, цвета, помощь для серии и наборы испытаний. Покупки остаются вашими навсегда. Каждое пройденное руководство даёт 20 XP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图标、颜色、连续记录助力和挑战包。物品永久归你。每完成一个指南可得 20 XP。"
          }
        }
      }
    },
