    "Yesterday had no activity, so a freeze kept your streak going. Freezes left: %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestern gab es keine Aktivität, also hat ein Freeze deine Serie gehalten. Verbleibende Freezes: %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayer no hubo actividad, así que una congelación mantuvo tu racha. Congelaciones restantes: %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier, aucune activité : un gel a maintenu votre série. Gels restants : %lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieri nessuna attività, quindi un congelamento ha mantenuto la tua serie. Congelamenti rimasti: %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨日は記録がなかったため、フリーズで連続記録を維持しました。残りのフリーズ: %lld"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어제는 기록이 없어 프리즈가 연속 기록을 이어줬어요. 남은 프리즈: %lld"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontem ficou sem registro, então um congelamento manteve sua sequência. Congelamentos restantes: %lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вчера не было активности, поэтому заморозка сохранила серию. Осталось заморозок: %lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨天没有记录，已用一张冻结卡保持连续记录。剩余冻结卡：%lld。"
          }
        }
      }
    },
