        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueada"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыто"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未解锁"
          }
        }
      }
    },
    "Locking asks to unlock whenever Cashly comes back to the front and hides the content in the app switcher. Discreet mode blurs every amount until you turn it off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Sperre fragt Cashly beim Zurückkehren in den Vordergrund nach dem Entsperren und verbirgt den Inhalt im App-Umschalter. Der diskrete Modus verwischt alle Beträge, bis du ihn ausschaltest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el bloqueo, Cashly pide desbloquear cada vez que vuelve al frente y oculta el contenido en el selector de apps. El modo discreto difumina todos los importes hasta que lo desactives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le verrouillage, Cashly demande à déverrouiller chaque fois qu’il revient au premier plan et masque le contenu dans le sélecteur d’apps. Le mode discret floute tous les montants jusqu’à sa désactivation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il blocco, Cashly chiede di sbloccare ogni volta che torna in primo piano e nasconde il contenuto nel selettore app. La modalità discreta sfoca tutti gli importi finché non la disattivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックをオンにすると、Cashlyが前面に戻るたびにロック解除を求め、Appスイッチャーで内容を隠します。控えめモードはオフにするまですべての金額をぼかします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금을 켜면 Cashly가 앞으로 돌아올 때마다 잠금 해제를 요청하고 앱 전환기에서 내용을 가려요. 비공개 모드는 끌 때까지 모든 금액을 흐리게 표시해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o bloqueio, o Cashly pede para desbloquear sempre que volta ao primeiro plano e esconde o conteúdo no seletor de apps. O modo discreto borra todos os valores até você desligar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С блокировкой Cashly просит разблокировать при каждом возвращении на передний план и скрывает содержимое в переключателе приложений. Скромный режим размывает все суммы, пока вы его не выключите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启锁定后，Cashly 每次回到前台都会要求解锁，并在应用切换器中隐藏内容。隐私模式会模糊所有金额，直到你关闭它。"
          }
        }
      }
    },
