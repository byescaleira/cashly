    "Level, streak, missions, challenges and achievements. Hiding the tab keeps your progress." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Level, Serie, Missionen, Challenges und Erfolge. Beim Ausblenden bleibt dein Fortschritt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nivel, racha, misiones, retos y logros. Ocultar la pestaña conserva tu progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niveau, série, missions, défis et succès. Masquer l’onglet conserve votre progression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livello, serie, missioni, sfide e traguardi. Nascondere la scheda mantiene i tuoi progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レベル、連続記録、ミッション、チャレンジ、実績。タブを隠しても進捗は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레벨, 연속 기록, 미션, 챌린지, 업적. 탭을 숨겨도 진행 상황은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nível, sequência, missões, desafios e conquistas. Esconder a aba mantém seu progresso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уровень, серия, задания, челленджи и достижения. Если скрыть вкладку, прогресс сохранится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等级、连续记录、任务、挑战和成就。隐藏此标签页不会丢失进度。"
          }
        }
      }
    },
