    "Sample data adds five users, categories, tags, budgets and transactions to the current records." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispieldaten fügen den vorhandenen Einträgen fünf Benutzer, Kategorien, Tags, Budgets und Transaktionen hinzu."
          }
        },
        "es" : {
