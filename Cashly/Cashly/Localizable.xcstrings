    "Think of the answer to life, the universe and everything." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denk an die Antwort auf das Leben, das Universum und den ganzen Rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piensa en la respuesta a la vida, el universo y todo lo demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensez à la réponse sur la vie, l’univers et le reste."
          }
        },
        "it" : {
