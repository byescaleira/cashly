          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las categorías muy por encima de su ritmo habitual aparecen aquí antes de ser un problema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les catégories bien au-dessus de leur rythme habituel apparaissent ici avant de poser problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
