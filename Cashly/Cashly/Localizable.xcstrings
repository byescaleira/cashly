          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez les dépenses du mois sous le total de vos budgets. Un mois compte une fois terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni le spese del mese entro il totale dei tuoi budget. Il mese conta quando si chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月の支出を予算の合計内に収めましょう。月が終わると判定されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 달 지출을 예산 합계 안으로 유지하세요. 달이 끝나면 집계돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha os gastos do mês dentro do total dos seus orçamentos. O mês conta quando fecha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите траты месяца в пределах суммы бюджетов. Месяц засчитывается после закрытия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让当月支出不超过预算总额。月份结束后才会计入。"
          }
        }
      }
    },
    "Keep this week under your average week of the last month." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib diese Woche unter deiner durchschnittlichen Woche des letzten Monats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén esta semana por debajo de tu semana media del último mes."
          }
        },
        "fr" : {
