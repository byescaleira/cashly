        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre uma transação ou marque um dia sem gastos para manter a sequência. Um congelamento cobre sozinho um dia perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите транзакцию или отметьте день без трат, чтобы не прерывать серию. Заморозка сама закрывает пропущенный день."
