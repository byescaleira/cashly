            "state" : "translated",
            "value" : "Mira si gastas más o menos de lo habitual a estas alturas del mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez si vous dépensez plus ou moins que d’habitude à ce stade du mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri se stai spendendo più o meno del solito a questo punto del mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月のこの時点で、いつもより多く使っているか少ないかがわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 달 이 시점에 평소보다 더 쓰는지 덜 쓰는지 알 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja se está gastando mais ou menos que o normal nesta altura do mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Узнайте, тратите ли вы больше или меньше обычного к этому дню месяца."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看看到月中这个时候，你比平时花得多还是少。"
          }
        }
      }
    },
    "Select a profile before continuing." : {
      "localizations" : {
