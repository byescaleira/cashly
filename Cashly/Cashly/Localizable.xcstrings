    "%@ %@ at %@ wants to read your Cashly data and send transactions. You still review every submission." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ unter %3$@ möchte deine Cashly-Daten lesen und Transaktionen senden. Du prüfst trotzdem jede Übermittlung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ en %3$@ quiere leer tus datos de Cashly y enviar transacciones. Revisarás cada envío."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ à l’adresse %3$@ souhaite lire vos données Cashly et envoyer des transactions. Vous vérifierez chaque envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ su %3$@ vuole leggere i tuoi dati di Cashly e inviare transazioni. Controllerai comunque ogni invio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ の %1$@ %2$@ が、Cashlyのデータを読み取り、取引を送信しようとしています。送信内容はすべて確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@의 %1$@ %2$@이(가) Cashly 데이터를 읽고 거래를 보내려고 합니다. 보낸 내용은 모두 직접 검토합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ em %3$@ quer ler seus dados do Cashly e enviar transações. Cada envio ainda passa pela sua conferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ по адресу %3$@ хочет читать данные Cashly и отправлять операции. Вы по-прежнему проверяете каждую отправку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ 上的 %1$@ %2$@ 想要读取你的 Cashly 数据并发送交易。每次提交仍需你审核。"
          }
        }
      }
    },
