    "Some budgets reference each other in a loop. The data was kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Budgets verweisen ringförmig aufeinander. Die Daten wurden beibehalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos presupuestos se referencian entre sí en bucle. Los datos se conservaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains budgets se référencent mutuellement en boucle. Les données ont été conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni budget si riferiscono a vicenda in un ciclo. I dati sono stati mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の予算が互いを循環参照しています。データは保持されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 예산이 서로를 순환 참조하고 있습니다. 데이터는 보존되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existem referências circulares entre orçamentos. Os dados foram preservados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые бюджеты ссылаются друг на друга по кругу. Данные сохранены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分预算之间存在循环引用。数据已保留。"
          }
        }
      }
    },
    "Some records are still waiting to sync. Totals only include the records available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Einträge warten noch auf die Synchronisierung. Die Summen enthalten nur die verfügbaren Einträge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos registros aún esperan sincronizarse. Los totales solo incluyen los registros disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données attendent encore la synchronisation. Les totaux n’incluent que les données disponibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni dati attendono ancora la sincronizzazione. I totali includono solo i dati disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期待ちの記録があります。合計には利用可能な記録だけが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 동기화를 기다리는 기록이 있습니다. 합계에는 사용 가능한 기록만 포함됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há registros incompletos aguardando sincronização. Os totais exibidos consideram apenas os registros disponíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые записи ещё ждут синхронизации. Итоги учитывают только доступные записи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分记录仍在等待同步。总额只包含可用的记录。"
          }
        }
      }
    },
    "Some transactions in storage have conflicting IDs. The records were kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige gespeicherte Transaktionen haben widersprüchliche IDs. Die Einträge wurden beibehalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas transacciones almacenadas tienen ID en conflicto. Los registros se conservaron."
