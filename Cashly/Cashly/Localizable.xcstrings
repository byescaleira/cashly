    "Budgets, upcoming bills and a forecast of where the month is heading, all on one screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budgets, anstehende Rechnungen und eine Prognose, wohin der Monat geht, alles auf einem Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presupuestos, próximas cuentas y una previsión de hacia dónde va el mes, todo en una sola pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budgets, factures à venir et une prévision de la direction que prend le mois, le tout sur un seul écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budget, bollette in arrivo e una previsione di dove sta andando il mese, tutto in una sola schermata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算、支払い予定、今月の見通しを、ひとつの画面で。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예산, 다가오는 청구서, 이번 달 전망을 한 화면에서."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orçamentos, próximas contas e uma previsão de para onde o mês vai, tudo numa tela só."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бюджеты, предстоящие счета и прогноз того, куда движется месяц, — всё на одном экране."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预算、待付账单和本月走向预测，全部在一个屏幕上。"
          }
        }
      }
    },
    "Build Your Spreadsheet" : {
      "localizations" : {
