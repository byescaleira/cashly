        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 날짜와 기록이 적어 시간이 지날수록 예측이 정확해집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
