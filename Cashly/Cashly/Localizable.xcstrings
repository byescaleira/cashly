          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una transacción, añade los perfiles que dividieron la cuenta contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans une transaction, ajoutez les profils qui ont partagé l’addition avec vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In una transazione, aggiungi i profili che hanno diviso il conto con te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取引に、一緒に支払いを分けたプロファイルを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거래에 함께 비용을 나눈 프로필을 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numa transação, adicione os perfis que dividiram a conta com você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте в операцию профили, с которыми вы разделили счёт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在交易中添加与你一起分摊账单的档案。"
          }
        }
      }
    },
    "In the Shortcuts app, Add Expense has every field of the editor: description, status, date, tags, shared profiles, split, installments and profile. Chain them: a shortcut that records your commute every weekday." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Kurzbefehle-App hat „Ausgabe erfassen“ jedes Feld des Editors: Beschreibung, Status, Datum, Tags, geteilte Profile, Aufteilung, Raten und Profil. Kombiniere sie: ein Kurzbefehl, der jeden Werktag deinen Arbeitsweg erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la app Atajos, Añadir gasto tiene todos los campos del editor: descripción, estado, fecha, etiquetas, perfiles con los que se divide, división, cuotas y perfil. Encadénalos: un atajo que registra tu trayecto cada día laborable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l’app Raccourcis, Ajouter une dépense a tous les champs de l’éditeur : description, statut, date, tags, profils du partage, partage, échéances et profil. Enchaînez-les : un raccourci qui enregistre votre trajet chaque jour de semaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nell’app Comandi, Aggiungi spesa ha tutti i campi dell’editor: descrizione, stato, data, tag, profili con cui dividere, divisione, rate e profilo. Concatenali: un comando che registra il tragitto ogni giorno feriale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットAppの「支出を追加」には、説明、状態、日付、タグ、分けるプロファイル、分け方、分割払い、プロファイルなどエディタの全項目があります。組み合わせれば、平日の通勤を毎日記録するショートカットも作れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축어 앱의 지출 추가에는 설명, 상태, 날짜, 태그, 함께 나눌 프로필, 분할, 할부, 프로필까지 편집기의 모든 항목이 있어요. 이어 붙여 보세요: 평일마다 출퇴근 비용을 기록하는 단축어."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No app Atalhos, Registrar gasto tem todos os campos do editor: descrição, status, data, tags, perfis da divisão, divisão, parcelas e perfil. Encadeie: um atalho que registra o transporte todo dia útil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В приложении «Команды» действие «Добавить расход» содержит все поля редактора: описание, статус, дату, теги, профили для разделения, разделение, рассрочку и профиль. Объединяйте их: команда, которая записывает дорогу на работу каждый будний день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“快捷指令”App 中，“添加支出”包含编辑器的所有字段：描述、状态、日期、标签、分摊档案、分摊、分期和档案。把它们串起来：一个每个工作日记录通勤费用的快捷指令。"
          }
        }
      }
    },
