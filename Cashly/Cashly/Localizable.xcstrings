            "value" : "%1$@에는 %2$@ 예산이 이미 있습니다. 다른 달을 고르거나 그 예산을 편집하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ já tem um orçamento em %2$@. Escolha outro mês ou edite esse orçamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У категории «%1$@» уже есть бюджет на %2$@. Выберите другой месяц или измените этот бюджет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 在 %2$@ 已有预算。请选择其他月份或编辑该预算。"
