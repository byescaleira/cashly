    "Without Cashly Pro your data stays visible and exportable, but recording and editing are locked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Cashly Pro bleiben deine Daten sichtbar und exportierbar, aber Erfassen und Bearbeiten sind gesperrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin Cashly Pro tus datos siguen visibles y exportables, pero registrar y editar quedan bloqueados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans Cashly Pro, vos données restent visibles et exportables, mais l’enregistrement et la modification sont verrouillés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza Cashly Pro i tuoi dati restano visibili ed esportabili, ma registrare e modificare sono bloccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly Proがなくてもデータの閲覧と書き出しはできますが、記録と編集はロックされます。"
