    "A budget already exists for this category and month. Edit the existing budget." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Kategorie und diesen Monat gibt es bereits ein Budget. Bearbeite das vorhandene Budget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un presupuesto para esta categoría y mes. Edita el presupuesto existente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un budget existe déjà pour cette catégorie et ce mois. Modifiez le budget existant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un budget per questa categoria e questo mese. Modifica il budget esistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このカテゴリと月の予算はすでにあります。既存の予算を編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
