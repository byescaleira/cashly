    "It stays at 1,000 up to 85% of the plan and drops gradually after that." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bleibt bis 85 % der Planung bei 1.000 und sinkt danach allmählich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mantiene en 1000 hasta el 85 % de lo planificado y baja poco a poco después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste à 1 000 jusqu’à 85 % du prévu, puis baisse progressivement."
