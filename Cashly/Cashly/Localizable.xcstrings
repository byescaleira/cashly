        }
      }
    },
    "Any amount counts, even a coffee. It takes a few seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Betrag zählt, auch ein Kaffee. Das dauert nur Sekunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier importe cuenta, hasta un café. Lleva unos segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout montant compte, même un café. Ça prend quelques secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni importo conta, anche un caffè. Bastano pochi secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーヒー1杯でもOK。数秒で終わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커피 한 잔도 괜찮아요. 몇 초면 끝나요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer valor conta, até um cafezinho. Leva poucos segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подойдёт любая сумма, даже кофе. Это пара секунд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何金额都算，哪怕一杯咖啡。几秒钟就好。"
          }
        }
      }
    },
    "Keep the month's spending within the total of your budgets. A month counts once it closes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Ausgaben des Monats innerhalb der Summe deiner Budgets. Ein Monat zählt, sobald er abgeschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el gasto del mes dentro del total de tus presupuestos. El mes cuenta cuando se cierra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez les dépenses du mois sous le total de vos budgets. Un mois compte une fois terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni le spese del mese entro il totale dei tuoi budget. Il mese conta quando si chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月の支出を予算の合計内に収めましょう。月が終わると判定されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 달 지출을 예산 합계 안으로 유지하세요. 달이 끝나면 집계돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha os gastos do mês dentro do total dos seus orçamentos. O mês conta quando fecha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите траты месяца в пределах суммы бюджетов. Месяц засчитывается после закрытия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让当月支出不超过预算总额。月份结束后才会计入。"
          }
        }
      }
    },
    "Spend at most %@ of the month's budget total." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib höchstens %@ der Budgetsumme des Monats aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gasta como máximo el %@ del total presupuestado del mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dépensez au plus %@ du total budgété du mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spendi al massimo il %@ del totale del budget del mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月の予算合計の%@以内に支出を抑えましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 달 예산 합계의 %@ 이하로만 쓰세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaste no máximo %@ do total orçado no mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тратьте не больше %@ от суммы бюджетов месяца."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出不超过当月预算总额的 %@。"
          }
        }
      }
    },
    "A month below 895 restarts the run, so check your budgets before each month ends." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Monat unter 895 startet die Folge neu, also prüfe deine Budgets vor jedem Monatsende."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mes por debajo de 895 reinicia la racha, así que revisa tus presupuestos antes de que acabe cada mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mois sous 895 relance le compteur : vérifiez vos budgets avant la fin de chaque mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mese sotto 895 fa ripartire la serie: controlla i budget prima della fine di ogni mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "895未満の月があると連続はリセット。毎月末の前に予算を確認しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "895 미만인 달이 있으면 연속 기록이 초기화돼요. 매달 끝나기 전에 예산을 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um mês abaixo de 895 reinicia a contagem, então confira seus orçamentos antes de cada mês acabar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Месяц ниже 895 обнуляет серию, так что проверяйте бюджеты до конца каждого месяца."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要有一个月低于 895，连续记录就会重来，所以每月结束前看看预算。"
          }
        }
      }
    },
    "Add a tag when you record: Trip, Work, Gift. Each different tag counts once." : {
      "localizations" : {
        "de" : {
