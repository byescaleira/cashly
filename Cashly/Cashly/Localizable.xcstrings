          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o Cashly numa nova despesa, pela Central de Controle, pela Tela Bloqueada ou pelo Botão de Ação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает Cashly на новом расходе из Пункта управления, с экрана блокировки или кнопкой действия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从控制中心、锁定屏幕或操作按钮直接打开 Cashly 的新支出。"
          }
        }
      }
    },
