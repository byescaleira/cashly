    "Changing the currency changes only the symbol. The numbers you recorded stay the same, and new records use the new currency." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Währungswechsel ändert nur das Symbol. Deine erfassten Zahlen bleiben gleich, neue Einträge verwenden die neue Währung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar la moneda solo cambia el símbolo. Los números que registraste siguen igual y los nuevos registros usan la nueva moneda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer de devise ne change que le symbole. Les nombres enregistrés restent les mêmes et les nouveaux enregistrements utilisent la nouvelle devise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare valuta cambia solo il simbolo. I numeri registrati restano uguali e i nuovi movimenti usano la nuova valuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通貨を変えても記号が変わるだけです。記録した数字はそのままで、新しい記録は新しい通貨になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화를 바꾸면 기호만 바뀌어요. 기록한 숫자는 그대로이고 새 기록은 새 통화를 사용해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocar a moeda muda só o símbolo. Os números que você registrou continuam iguais, e os novos registros usam a nova moeda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При смене валюты меняется только символ. Записанные числа остаются прежними, а новые записи будут в новой валюте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改货币只会改变符号。已记录的数字保持不变，新记录将使用新货币。"
          }
        }
      }
    },
