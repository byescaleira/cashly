    "Cashly couldn't get exchange rates. Amounts saved in other currencies show without conversion." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly konnte keine Wechselkurse abrufen. Beträge in anderen Währungen werden ohne Umrechnung angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly no pudo obtener los tipos de cambio. Los importes guardados en otras monedas se muestran sin convertir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly n'a pas pu obtenir les taux de change. Les montants dans d'autres devises s'affichent sans conversion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly non è riuscito a ottenere i tassi di cambio. Gli importi in altre valute vengono mostrati senza conversione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashlyは為替レートを取得できませんでした。他の通貨で保存した金額は換算せずに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly가 환율을 불러오지 못했어요. 다른 통화로 저장된 금액은 환산 없이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cashly não conseguiu buscar as cotações. Valores salvos em outras moedas aparecem sem conversão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly не удалось получить курсы валют. Суммы в других валютах показываются без пересчёта."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly 无法获取汇率。以其他货币保存的金额将不经换算显示。"
          }
        }
      }
    },
    "Shown converted" : {
