            "state" : "translated",
            "value" : "隐私"
          }
        }
      }
    },
    "Discreet mode blurs every amount until you turn it off. Names and categories stay readable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der diskrete Modus verwischt alle Beträge, bis du ihn ausschaltest. Namen und Kategorien bleiben lesbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo discreto difumina todos los importes hasta que lo desactives. Los nombres y las categorías siguen legibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode discret floute tous les montants jusqu’à ce que vous le désactiviez. Les noms et catégories restent lisibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità discreta sfoca tutti gli importi finché non la disattivi. Nomi e categorie restano leggibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控えめモードはオフにするまですべての金額をぼかします。名前やカテゴリは読めるままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비공개 모드는 끌 때까지 모든 금액을 흐리게 해요. 이름과 카테고리는 그대로 보여요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo discreto borra todos os valores até você desligar. Nomes e categorias continuam legíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скромный режим размывает все суммы, пока вы его не выключите. Названия и категории остаются читаемыми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐私模式会模糊所有金额，直到你将其关闭。名称和类别仍可阅读。"
          }
        }
      }
    },
    "Lock and discreet mode don't sync to your other devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre und diskreter Modus werden nicht mit deinen anderen Geräten synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloqueo y el modo discreto no se sincronizan con tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verrouillage et le mode discret ne se synchronisent pas avec vos autres appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco e la modalità discreta non si sincronizzano con gli altri dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックと控えめモードはほかのデバイスと同期されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금과 비공개 모드는 다른 기기와 동기화되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bloqueio e o modo discreto não sincronizam com seus outros aparelhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокировка и скромный режим не синхронизируются с другими устройствами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定和隐私模式不会同步到你的其他设备。"
          }
        }
      }
    },
