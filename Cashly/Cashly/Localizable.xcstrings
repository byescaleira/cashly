        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashly에서 확인합니다. 곧 이번 달이 열리고 24시간 동안 최신 상태로 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Cashly 中确认。本月信息很快就会在那里打开，并在 24 小时内保持最新。"
          }
