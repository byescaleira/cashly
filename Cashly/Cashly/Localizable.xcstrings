          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma in Cashly. Il tuo mese si apre lì in un attimo e resta aggiornato per 24 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cashlyで確認します。すぐに今月が表示され、24時間最新の状態に保たれます。"
          }
