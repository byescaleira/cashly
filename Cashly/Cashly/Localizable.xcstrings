    "Equally, by fixed amount or by percentage. Cashly works out each person's share." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu gleichen Teilen, mit festem Betrag oder prozentual. Cashly berechnet den Anteil jeder Person."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partes iguales, por importe fijo o por porcentaje. Cashly calcula la parte de cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À parts égales, par montant fixe ou par pourcentage. Cashly calcule la part de chacun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In parti uguali, con importo fisso o in percentuale. Cashly calcola la quota di ciascuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "均等、固定額、または割合で分けられます。各自の負担額はCashlyが計算します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "균등하게, 고정 금액으로, 또는 비율로 나눌 수 있습니다. 각자의 몫은 Cashly가 계산합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em partes iguais, por valor fixo ou por porcentagem. O Cashly calcula a parte de cada um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поровну, фиксированной суммой или в процентах. Cashly посчитает долю каждого."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可平均分摊、按固定金额或按百分比分摊。Cashly 会算出每个人的份额。"
          }
        }
      }
    },
