    "Confirm in Cashly. Your month opens there in a moment and stays up to date for 24 hours." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme no Cashly. Seu mês abre lá em instantes e fica atualizado por 24 horas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma en Cashly. Tu mes se abre allí en un momento y se mantiene al día durante 24 horas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige in Cashly. Dein Monat öffnet sich dort sofort und bleibt 24 Stunden lang aktuell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
