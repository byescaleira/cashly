        }
      }
    },
    "Name it the way you think about money: Groceries, Rent, Fun." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benenne sie so, wie du über Geld denkst: Lebensmittel, Miete, Freizeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponle el nombre como piensas en tu dinero: Súper, Alquiler, Ocio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nommez-la comme vous pensez votre argent : Courses, Loyer, Loisirs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiamala come pensi ai tuoi soldi: Spesa, Affitto, Svago."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お金の考え方に合わせて名前を：食料品、家賃、娯楽。"
