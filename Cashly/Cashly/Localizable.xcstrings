    "Shared profiles aren't available on this device yet. Update Cashly and open the invitation again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteilte Profile sind auf diesem Gerät noch nicht verfügbar. Aktualisiere Cashly und öffne die Einladung erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles compartidos aún no están disponibles en este dispositivo. Actualiza Cashly y vuelve a abrir la invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils partagés ne sont pas encore disponibles sur cet appareil. Mettez Cashly à jour et rouvrez l’invitation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili condivisi non sono ancora disponibili su questo dispositivo. Aggiorna Cashly e riapri l’invito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスではまだ共有プロファイルを利用できません。Cashlyをアップデートして、もう一度招待を開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 아직 공유 프로필을 사용할 수 없습니다. Cashly를 업데이트한 후 초대를 다시 여세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfis compartilhados ainda não estão disponíveis neste aparelho. Atualize o Cashly e abra o convite de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
