    "Opens Cashly on a new expense, from Control Center, the Lock Screen or the Action Button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet Cashly mit einer neuen Ausgabe – aus dem Kontrollzentrum, vom Sperrbildschirm oder mit der Aktionstaste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Cashly en un nuevo gasto desde el centro de control, la pantalla bloqueada o el botón de acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Cashly sur une nouvelle dépense, depuis le centre de contrôle, l'écran verrouillé ou le bouton Action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre Cashly su una nuova spesa dal Centro di Controllo, dalla schermata di blocco o dal tasto Azione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールセンター、ロック画面、アクションボタンから、新しい支出の画面でCashlyを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어 센터, 잠금 화면 또는 동작 버튼에서 새 지출 화면으로 Cashly를 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o Cashly numa nova despesa, pela Central de Controle, pela Tela Bloqueada ou pelo Botão de Ação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает Cashly на новом расходе из Пункта управления, с экрана блокировки или кнопкой действия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从控制中心、锁定屏幕或操作按钮直接打开 Cashly 的新支出。"
          }
        }
      }
    },
