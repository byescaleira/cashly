    "Initials follow the name. A symbol or an illustration stays the same when the name changes." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As iniciais acompanham o nome. Um símbolo ou uma ilustração continua igual quando o nome muda."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las iniciales siguen al nombre. Un símbolo o una ilustración no cambia aunque cambie el nombre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Initialen folgen dem Namen. Ein Symbol oder eine Illustration bleibt gleich, wenn sich der Name ändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les initiales suivent le nom. Un symbole ou une illustration reste identique si le nom change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le iniziali seguono il nome. Un simbolo o un’illustrazione restano uguali se il nome cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イニシャルは名前に合わせて変わります。シンボルやイラストは名前を変えてもそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이니셜은 이름을 따라 바뀝니다. 기호나 일러스트는 이름이 바뀌어도 그대로입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首字母会随名称变化。符号或插画在名称更改后保持不变。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инициалы меняются вместе с именем. Символ или иллюстрация остаются прежними, если имя изменится."
          }
        }
      }
    },
