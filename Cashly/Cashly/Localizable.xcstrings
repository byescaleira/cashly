    "Mark each participant as paid or to receive to know who still owes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere jede Person als bezahlt oder ausstehend, um zu sehen, wer noch etwas schuldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca a cada participante como pagado o por cobrar para saber quién debe todavía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez pour chaque participant s’il a payé ou s’il reste à recevoir pour savoir qui doit encore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna ogni partecipante come pagato o da ricevere per sapere chi deve ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参加者ごとに支払済みか受取予定かを設定すると、誰がまだ払っていないかがわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참여자별로 지불 완료 또는 받을 금액으로 표시하면 누가 아직 빚졌는지 알 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque cada participante como pago ou a receber para saber quem ainda deve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечайте каждого участника как оплатившего или должника, чтобы знать, кто ещё должен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将每位参与者标记为已付或待收，就能知道谁还欠款。"
          }
        }
      }
