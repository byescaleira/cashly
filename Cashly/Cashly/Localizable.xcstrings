    "Record a transaction or mark a no-spend day to keep it going. A freeze covers a missed day on its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse eine Transaktion oder markiere einen ausgabenfreien Tag, um die Serie zu halten. Ein Freeze deckt einen verpassten Tag automatisch ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra una transacción o marca un día sin gastos para mantenerla. Un congelador cubre solo un día perdido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une transaction ou marquez une journée sans dépense pour la poursuivre. Un gel couvre automatiquement un jour manqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra una transazione o segna un giorno senza spese per mantenerla. Un congelamento copre da solo un giorno mancato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取引を記録するか、支出なしの日を記録すると続きます。フリーズは記録を忘れた日を自動でカバーします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거래를 기록하거나 무지출 날을 표시하면 이어집니다. 프리즈는 놓친 하루를 자동으로 막아 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre uma transação ou marque um dia sem gastos para manter a sequência. Um congelamento cobre sozinho um dia perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите транзакцию или отметьте день без трат, чтобы не прерывать серию. Заморозка сама закрывает пропущенный день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录一笔交易或标记零花费日即可保持。冻结卡会自动抵消错过的一天。"
          }
        }
      }
    },
